{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M3",
  "version": "0.1.0",
  "identifier": "local.m3.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../client/dist",
    "devUrl": "http://127.0.0.1:7007"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "M3",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "M3 personal brain",
    "longDescription": "M3 is a local-first personal knowledge operating system. Capture, search, and chat with your own notes — the brain lives as markdown files at ~/brain/.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null,
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
