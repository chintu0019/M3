# M3 Environment Variables
# Copy to .env and fill in your values, or run scripts/setup.sh.

# --- LLM ---------------------------------------------------------------------
# Easiest path: install the `claude` CLI (Claude Code) and set the default
# provider to local_agent. No API key needed -- M3 reuses your existing login.
M3_LLM__DEFAULT_PROVIDER=local_agent

# Or bring your own API key for one of these providers:
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Required ----------------------------------------------------------------
M3_API_KEY=your-secret-api-key

# --- Optional ----------------------------------------------------------------
DB_PASSWORD=m3dev
# MinIO defaults are insecure -- override before exposing the console publicly.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TELEGRAM_BOT_TOKEN=
M3_DOMAIN=localhost

# --- Host ports --------------------------------------------------------------
# scripts/setup.sh probes for free ports and writes the chosen values here.
# You can also set them by hand. If you delete these lines, defaults apply.
M3_HTTP_PORT=80
M3_HTTPS_PORT=443
M3_API_PORT=8000
M3_POSTGRES_PORT=5432
M3_REDIS_PORT=6380
M3_MINIO_PORT=9000
M3_MINIO_CONSOLE_PORT=9001
