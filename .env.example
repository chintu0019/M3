# M3 Environment Variables
# Copy to .env and fill in your values.

# LLM Provider (pick one)
MINIMAX_API_KEY=your-minimax-key
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Required
M3_API_KEY=your-secret-api-key

# Optional
DB_PASSWORD=m3dev
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TELEGRAM_BOT_TOKEN=
M3_DOMAIN=localhost
