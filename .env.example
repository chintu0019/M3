# M3 environment variables (all optional)
#
# M3 reads its real configuration from ~/brain/.m3/config.yml — set up via
# `m3 init` or the in-app Settings page. The variables below are *overrides*
# for headless / dev / CI scenarios. The desktop app does not need any of
# them.

# LLM provider — only honoured when ~/brain/.m3/config.yml is missing or
# explicitly defers to env. The Settings UI is the supported way to change
# providers at runtime.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
M3_LLM_PROVIDER=

# Bring-your-own local agent CLI (claude, codex, gemini, aider, mods, llm…).
# Path to the binary + space-separated arg template.
LOCAL_AGENT_COMMAND=
LOCAL_AGENT_ARGS=

# Bearer token for the HTTP API. Falls back to the value in config.yml.
M3_API_KEY=
M3_REQUIRE_AUTH=

# Server bind + storage paths.
M3_HOST=127.0.0.1
M3_PORT=7007
M3_BRAIN=
M3_LOG_DIR=

# Telegram capture bot.
M3_TELEGRAM_TOKEN=
M3_TELEGRAM_ALLOWED_CHATS=
